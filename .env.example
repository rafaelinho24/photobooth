# Copy this file to .env and fill in your values
# Never commit .env to git

# Express backend port (default: 3001)
PORT=3001

# Canon R6 Mark II IP when connected via USB (CCAPI)
CAMERA_IP=192.168.1.3

# Folder where EOS Utility saves photos
PHOTOS_FOLDER=C:\Users\rafae\Pictures\EOS Utility

# Exact printer name as shown in Windows > Printers & Scanners
PRINTER_NAME=Canon SELPHY CP1500
